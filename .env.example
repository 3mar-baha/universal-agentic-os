# Universal Agentic Engineering OS - example environment file
# Copy to .env and replace every placeholder with a real value.
# Never commit .env or any real credential; reference variables by name only.

# Toolkit directory used by scripts/setup-toolkit.sh and scripts/sync-toolkit.sh.
# Uncomment to override; otherwise both scripts fall back to this default path.
# CLAUDE_TOOLKIT_DIR=~/ai-agent-toolkit

# Model provider credentials for injected agent sessions (placeholders only)
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OPENROUTER_API_KEY=<your-openrouter-api-key>

# MCP server credentials (.mcp.json references these by name only)
BRAVE_API_KEY=<your-brave-search-api-key>

# GitHub token used by gh during release packaging (phase 4 - Harden & Release)
GITHUB_TOKEN=<your-github-token>

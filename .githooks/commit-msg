#!/usr/bin/env bash
#
# commit-msg — zero AI attribution gate for commit messages.
#
# Companion to .githooks/pre-commit: the pre-commit hook scans staged
# content, this one scans the message itself. Rejects trailers and
# footers such as "Co-authored-by: Claude" or "Generated with Claude Code".
#
# Activate with:  bash scripts/setup-git-hooks.sh

set -u

MSG_FILE="$1"

# The badge emoji is built from byte escapes so this hook's own source never
# contains the literal — otherwise pre-commit's scan of staged content would
# match the scanner itself.
ROBOT_EMOJI="$(printf '\xF0\x9F\xA4\x96')"

if [ ! -f "$MSG_FILE" ]; then
    printf 'COMMIT-MSG REJECTED: message file %s not found.\n' "$MSG_FILE" >&2
    exit 1
fi

if grep -iqE "co-authored-by:.*(claude|anthropic)|generated (with|by|using).*(claude|anthropic)|${ROBOT_EMOJI}" "$MSG_FILE"; then
    cat >&2 <<'EOF'
COMMIT-MSG REJECTED: the commit message contains AI attribution.
This repository enforces zero AI attribution in its history.
EOF
    exit 1
fi

exit 0
